{
  "name": "@blueshed/delta",
  "version": "1.1.0",
  "description": "Delta-doc \u2014 JSON-Patch document sync with SQLite and Postgres backends, WebSocket transport, and reactive client signals",
  "type": "module",
  "main": "src/core.ts",
  "types": "src/core.ts",
  "bin": {
    "delta": "./cli.ts"
  },
  "exports": {
    ".": "./src/core.ts",
    "./core": "./src/core.ts",
    "./client": "./src/client/client.ts",
    "./dom-ops": "./src/client/dom-ops.ts",
    "./server": "./src/server/server.ts",
    "./sqlite": "./src/server/sqlite.ts",
    "./json": "./src/server/json.ts",
    "./local": "./src/server/local.ts",
    "./kinds": "./src/server/kinds.ts",
    "./logger": "./src/server/logger.ts",
    "./auth": "./src/server/auth.ts",
    "./auth-link": "./src/server/auth-link.ts",
    "./auth-link/client": "./src/client/auth-link.ts",
    "./migrations": "./src/server/changes.ts",
    "./testing": "./src/testing.ts",
    "./backend": "./src/backend.ts"
  },
  "files": [
    "cli.ts",
    "src/**/*.ts",
    "src/pointer-vectors.json",
    "src/walk-vectors.json",
    ".claude/skills/delta-doc/**",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepare": "bun -e \"import { cpSync, existsSync, rmSync } from 'node:fs'; const from = 'node_modules/@blueshed/railroad/.claude/skills/railroad'; if (existsSync(from)) { rmSync('.claude/skills/railroad', { recursive: true, force: true }); cpSync(from, '.claude/skills/railroad', { recursive: true }); }\"",
    "test": "bun test tests/",
    "ci": "bun check && bun check -p examples/kanban && bun test tests/"
  },
  "peerDependencies": {
    "@blueshed/railroad": "^0.11.0 || ^0.12.0 || ^0.13.0 || ^0.14.0 || ^0.15.0 || ^0.16.0"
  },
  "peerDependenciesMeta": {
    "@blueshed/railroad": {
      "optional": true
    }
  },
  "devDependencies": {
    "@blueshed/railroad": "^0.16.0",
    "@happy-dom/global-registrator": "^20.11.1",
    "@types/bun": "^1.4.2"
  },
  "author": "Peter Bunyan <peter@blueshed.co.uk> (https://blueshed.co.uk)",
  "license": "MIT",
  "homepage": "https://github.com/blueshed/delta",
  "repository": {
    "type": "git",
    "url": "https://github.com/blueshed/delta"
  },
  "keywords": [
    "delta-doc",
    "json-patch",
    "websocket",
    "postgres",
    "sqlite",
    "realtime"
  ]
}
